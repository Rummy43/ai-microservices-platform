# Copy to terraform.tfvars (git-ignored) and fill in values before applying.

aws_region          = "us-east-1"
environment         = "prod"
project             = "ai-platform"
eks_cluster_version = "1.31"
node_instance_type  = "t3.medium"
node_desired_count  = 2
node_min_count      = 1
node_max_count      = 3
use_spot_instances  = true   # saves ~80% on EC2 node cost — safe for demo runs

db_username             = "admin"
db_password             = "CHANGE_ME"
keycloak_admin_password = "CHANGE_ME"
